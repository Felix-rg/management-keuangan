# COPY these to Vercel Project > Settings > Environment Variables.
# Use Neon "Pooled connection" with SSL mode required.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST-pooler.us-east-2.aws.neon.tech/YOUR_DB?sslmode=require
APP_USERNAME=owner
APP_PASSWORD=USE_A_STRONG_UNIQUE_PASSWORD
SESSION_SECRET=REPLACE_WITH_RANDOM_64_OR_MORE_CHARACTERS
APP_ENV=production
